# Copy this file to .env and fill in real values. Never commit the real .env file.

DATABASE_URL=postgresql://postgres:password@localhost:5432/gpa_calculator

# Used to sign JWT auth tokens - generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-long-random-string

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

FRONTEND_ORIGIN=http://localhost:3000
